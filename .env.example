# Postgres connection string used by Prisma.
DATABASE_URL="postgresql://user:password@localhost:5432/movie_memory"

# NextAuth.js
# Generate with: npx auth secret   (or: openssl rand -base64 32)
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth credentials.
# Create at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# OpenAI API key. Never exposed to the client — only read in server-side code.
OPENAI_API_KEY=""
# Optional: override the model used for fact generation (defaults to gpt-4o-mini).
OPENAI_MODEL="gpt-4o-mini"

# Optional: max Postgres connections per server instance (default 5).
# Every instance opens its own pool, so keep instances x this below the DB's
# max_connections, and use a pooler (PgBouncer / your host's pooled URL) at scale.
# DATABASE_POOL_MAX=5

# Optional: log level for structured JSON logs (default info).
# LOG_LEVEL=info
